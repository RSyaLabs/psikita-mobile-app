# Normalize line endings in the working tree.
# core.autocrlf=true rewrote LF to CRLF on checkout, which produced
# "LF will be replaced by CRLF" churn on every edit and made diffs noisy.
* text=auto eol=lf

# Binary assets must never be line-ending translated.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mov binary

# Lockfile stays as generated.
package-lock.json -diff linguist-generated=true
