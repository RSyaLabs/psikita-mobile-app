{
  "build": {
    "production": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.psikita.id"
      },
      "android": {
        "package": "id.psikita.app"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.staging.seraphany.id/core"
      },
      "android": {
        "package": "id.psikita.app",
        "buildType": "apk"
      }
    }
  }
}
