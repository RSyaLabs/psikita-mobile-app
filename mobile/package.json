{
  "name": "psikita-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --maxWorkers=2",
    "test:integration": "cross-env PSIKITA_INTEGRATION=1 tsx --env-file=.env scripts/test-services.ts",
    "audit:contracts": "tsx scripts/contract-audit.ts",
    "audit:routes": "tsx scripts/e2e-audit.ts"
  },
  "dependencies": {
    "@expo/html-elements": "^57.0.0",
    "@expo/vector-icons": "~14.0.4",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@react-native/js-polyfills": "^0.87.1",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~52.0.30",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.5",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.0",
    "metro": "^0.81.5",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@gluestack-ui/core",
          "@gluestack-ui/utils",
          "@react-native/js-polyfills",
          "react-native-css-interop"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
