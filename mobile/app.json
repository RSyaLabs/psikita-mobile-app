    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "@didit-protocol/sdk-react-native",
      "./plugins/withSslPinning.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
