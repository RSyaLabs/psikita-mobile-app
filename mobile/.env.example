# PsiKita Mobile — Environment Variables Template
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Demo mode is opt-in; keep this false for production builds.
EXPO_PUBLIC_DEMO_MODE=false

# Local development fixtures. Serves invented data from src/config/fixtures/ so
# screens can be reviewed without a reachable backend.
#
# This is a SECOND gate, not an alias of EXPO_PUBLIC_DEMO_MODE. Both must be
# false in a release. EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time, so a build run from a machine whose .env sets this to true ships
# a binary with every capability guard open. eas.json pins it to false in the
# production profile precisely because a local .env cannot be trusted to.
EXPO_PUBLIC_USE_MOCK_FALLBACK=false
